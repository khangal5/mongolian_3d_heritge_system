# --- Үндсэн ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mongolian_heritage
UPLOAD_DIR=uploads

# --- Frontend холбоос ---
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- И-мэйл (бүртгэлийн баталгаажуулалт + нууц үг сэргээх) ---
# Доорхиос ямар нэгийг тохируулсан тохиолдолд имэйл бодит явна.
# Юу ч тохируулаагүй бол dev console-д линк гарна.

# Сонголт 1: Resend API
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=onboarding@resend.dev

# Сонголт 2: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@heritage.local

# Сонголт 3: Ethereal (хөгжүүлэлтийн тест зориулалт)
# EMAIL_USE_ETHERAL=true

# --- И-мэйл домэйны шалгалт ---
EMAIL_DOMAIN_WHITELIST=edu.mn,ac.mn,gov.mn,gmail.com
# EMAIL_DOMAIN_BYPASS=true   # dev-д бүх домэйн зөвшөөрөх

# --- Анхдагч админ (db:seed-admin script) ---
# ADMIN_EMAIL=admin@example.mn
# ADMIN_PASSWORD=Admin1234

# --- Reverse proxy ард ажиллавал ---
# TRUST_PROXY=1
